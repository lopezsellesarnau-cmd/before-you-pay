# Model: sample (no credentials) | anthropic | nvidia
LLM_PROVIDER=sample
# LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=
# NVIDIA_API_KEY=

# Zetaris (local platform or the event instance). Without it, the price check reads the local CSV.
ZETARIS_URL=http://localhost:3001
ZETARIS_USER=
ZETARIS_PASSWORD=

# Report language for the explanations: en | es
REPORT_LANG=en
# OFFLINE=1 serves Catastro and BOE from data/cache
